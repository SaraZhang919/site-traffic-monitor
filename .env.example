# Copy this file to `.env.local` and fill in your local values.
# Do not paste private credentials into chat.

# Absolute path to your Google service account JSON file.
# Example:
# GOOGLE_SERVICE_ACCOUNT_FILE=C:\Users\Tiziana\Desktop\AI agent\google-service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=

# Google Sheet ID used by the existing data automation workflow.
# This is the long ID in the spreadsheet URL.
GOOGLE_SHEET_ID=

# Optional: override tab names if your workbook uses different names.
GA4_DAILY_SHEET=Daily
GSC_DAILY_SHEET=Daily Site GSC
GSC_PAGE_QUERY_SHEET=Weekly Page GSC

# Optional: enable OpenAI-powered diagnosis and action enrichment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
